# 실제 키는 .env에만 입력합니다. 이 파일은 빈 설정 예시입니다.
KAKAO_JAVASCRIPT_KEY=
KAKAO_REST_API_KEY=
SEOUL_OPEN_DATA_API_KEY=
# 각 서비스 상세 페이지의 일반 인증키(Decoding)를 입력합니다.
DATA_GO_KR_APT_RENT_KEY=
DATA_GO_KR_RH_RENT_KEY=
DATA_GO_KR_SH_RENT_KEY=
DATA_GO_KR_OFFI_RENT_KEY=
# 공통키로 사용 가능한 경우에만 입력(선택). 유형별 키가 우선입니다.
DATA_GO_KR_SERVICE_KEY=

# LLM·임베딩 공급자 선정 후 연결할 항목
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# 대화 조건 추출: 기존 실습 GMS 설정 사용
GMS_KEY=
GMS_MODEL=gpt-5.4-nano
# 위키백과 연동 시 사용할 연락처(현재 미연동)
WIKI_CONTACT=

# 법정동별 성/연령별 주민등록 인구수(별도 활용신청)
MOIS_RESIDENT_API_KEY=
